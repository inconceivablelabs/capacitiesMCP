{
  "name": "capacities-mcp-server",
  "version": "2.0.0",
  "description": "MCP Server for Capacities knowledge management integration with advanced search, content creation, and analysis tools",
  "type": "module",
  "bin": {
    "capacities-mcp-server": "./server/dist/index.js"
  },
  "files": [
    "server/dist"
  ],
  "scripts": {
    "build": "tsc && chmod +x server/dist/index.js",
    "dev": "tsc --watch",
    "start": "node server/dist/index.js",
    "inspector": "npx @modelcontextprotocol/inspector server/dist/index.js",
    "test": "tsc -p tsconfig.test.json && node --test \"test-dist/test/**/*.test.js\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "dotenv": "^17.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "mcp",
    "capacities",
    "knowledge-management",
    "ai",
    "claude",
    "search",
    "zod",
    "typescript"
  ],
  "author": "Tom Booth",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/inconceivablelabs/capacitiesMCP.git"
  }
}
