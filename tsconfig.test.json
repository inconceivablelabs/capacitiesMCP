{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./test-dist",
    "rootDir": ".",
    "noEmit": false,
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "src/**/*",
    "test/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "server/dist",
    "src/tools/unused"
  ]
}
